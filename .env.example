# ACAIABA Environment Variables Example
PORT=3000
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database Configuration
DATABASE_URL="postgresql://acaiaba_user:acaiaba_pass@localhost:5432/acaiaba_db?schema=public"

# Authentication Config
JWT_SECRET="your-jwt-secret-key"
NEXTAUTH_SECRET="your-nextauth-secret-key"

# WhatsApp Notification Number (Format: 5511999999999)
WHATSAPP_NUMBER="5511999999999"
# Number used to build the client-side WhatsApp link (must be public). Leave the
# placeholder below unless a real number is provided.
NEXT_PUBLIC_WHATSAPP_NUMBER="5511999999999"

# External Integrations (Simulated/Abstractions)
# PAYMENT_PROVIDER selects the gateway implementation: "simulated" (default),
# and later "mercadopago" | "asaas" | "stripe".
PAYMENT_PROVIDER="simulated"
PAYMENT_PROVIDER_MODE="SANDBOX" # DEVELOPMENT, SANDBOX, PRODUCTION
# Secret used to verify incoming payment webhooks (shared with the provider).
PAYMENT_WEBHOOK_SECRET="change-me-webhook-secret"
SHIPPING_PROVIDER_MODE="SANDBOX" # DEVELOPMENT, SANDBOX, PRODUCTION
