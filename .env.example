# ============================================================================
# ACAIABA — Environment Variables (TEMPLATE)
# ----------------------------------------------------------------------------
# This file is committed on purpose and contains NO real credentials.
# Copy it to `.env` for local development:
#
#     cp .env.example .env
#
# `.env` and every `.env.*` variant are gitignored — never commit real values.
# Every entry below is either empty or a non-secret default.
#
# Only the variables actually read by the code are listed here.
# ============================================================================

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public origin of the deployment. Used by sitemap.xml, robots.txt and to resolve
# relative OpenGraph image URLs. Do NOT add a trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Database — PostgreSQL
# ---------------------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# On Neon, use the pooled endpoint (host ending in "-pooler") and keep
# ?sslmode=require at the end.
DATABASE_URL=""

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Signs the session JWT stored in the HttpOnly cookie. MANDATORY in every
# environment — there is no fallback in the code, the app refuses to start
# without it. Generate one with: openssl rand -base64 48
JWT_SECRET=""

# ---------------------------------------------------------------------------
# Seed (used only by `npx prisma db seed`)
# ---------------------------------------------------------------------------
# Credentials of the initial administrator. Both are MANDATORY: the seed has no
# default credential and aborts without them. Leave empty here and fill them in
# your local .env. Generate a password with: openssl rand -base64 24
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
# Selects the gateway implementation: "simulated" (default) | "mercadopago"
# | "asaas" | "stripe". Only "simulated" is implemented today.
PAYMENT_PROVIDER="simulated"
# "DEVELOPMENT" | "SANDBOX" | "PRODUCTION". Anything other than PRODUCTION runs
# in sandbox mode.
PAYMENT_PROVIDER_MODE="SANDBOX"
# Shared secret used to verify incoming payment webhooks. In production the
# simulated gateway rejects every webhook when this is not set.
PAYMENT_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Contact
# ---------------------------------------------------------------------------
# Public by design — it is rendered into a client-side wa.me link.
# Digits only, Brazilian format: 5511999999999
NEXT_PUBLIC_WHATSAPP_NUMBER="5511999999999"
